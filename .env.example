# Optional hosted database. Leave BOTH unset for local JSON storage.
# Put real values only in Render's environment settings.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
HOST=127.0.0.1
PORT=4000
# Local shell variables or `node --env-file=.env server.js` can load these.
# npm run dev does not automatically load the root .env file.
